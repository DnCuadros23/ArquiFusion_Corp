# Copia este archivo como .env (no se sube al repo).
# true = datos de prueba (no necesita AWS). Pon false cuando tengas la API_URL de Denilson.
VITE_USE_MOCK=true
# Ej: https://<id>.execute-api.us-east-1.amazonaws.com/prod/api  (sin barra al final)
VITE_API_URL=

# Configuración web de Firebase (Consola de Firebase -> Configuración del proyecto -> Tus apps -> Web).
# Solo se usa en el modo degradado (lectura de la réplica).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
