{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arquifusion/incidente",
  "title": "Incidente",
  "description": "Lo crea el detector al disparar la Step Function de incidente; cada paso del flujo lo va completando. Se guarda en t_incidentes y se replica a Firestore.",
  "type": "object",
  "required": ["tenant_id", "incidente_id", "maquina_id", "modelo", "zona", "creado_ts", "estado", "severidad", "variables_anomalas"],
  "properties": {
    "tenant_id":    { "type": "string" },
    "incidente_id": { "type": "string", "description": "uuid4" },
    "maquina_id":   { "type": "string" },
    "modelo":       { "type": "string" },
    "zona":         { "type": "string" },
    "lat":          { "type": "number" },
    "lon":          { "type": "number" },
    "creado_ts":    { "type": "string", "format": "date-time" },
    "estado": {
      "type": "string",
      "enum": ["DETECTADO", "ANALIZADO", "ASIGNADO", "EN_ATENCION", "CERRADO", "DESCARTADO"]
    },
    "severidad": {
      "type": "string",
      "enum": ["OBSERVACION", "MEDIA", "CRITICA"],
      "description": "OBSERVACION: 1 variable desviada. MEDIA: 2+ persistentes. CRITICA: 3+ o fuera de rango físico"
    },
    "variables_anomalas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["variable", "valor", "media_habitual", "z"],
        "properties": {
          "variable":       { "type": "string", "description": "Nombre del campo de telemetría. Ej: temp_motor_c" },
          "valor":          { "type": "number" },
          "media_habitual": { "type": "number" },
          "z":              { "type": "number", "description": "Desviaciones estándar respecto a su historial" },
          "minutos_persistente": { "type": "number" }
        }
      }
    },
    "analisis_ia": {
      "type": "object",
      "description": "Respuesta de Gemini. Nunca es un diagnóstico confirmado.",
      "properties": {
        "nivel_riesgo":   { "type": "string", "enum": ["BAJO", "MEDIO", "ALTO"] },
        "resumen":        { "type": "string" },
        "posibles_causas_a_revisar": { "type": "array", "items": { "type": "string" } },
        "especialidad_sugerida": { "type": "string", "enum": ["MOTOR", "HIDRAULICO", "ELECTRICO", "TREN_RODAJE", "GENERAL"] },
        "mensajes_por_rol": {
          "type": "object",
          "properties": {
            "tecnico":    { "type": "string" },
            "supervisor": { "type": "string" },
            "gerente":    { "type": "string" }
          }
        },
        "es_diagnostico": { "const": false },
        "fuente":         { "type": "string", "enum": ["GEMINI", "PLANTILLA"], "description": "PLANTILLA si la IA no respondió" }
      }
    },
    "grupo_causa_comun": { "type": ["string", "null"], "description": "Id del grupo si hay 3+ incidentes en la misma zona en 60 min" },
    "tecnico_asignado": {
      "type": ["object", "null"],
      "properties": {
        "tecnico_id":   { "type": "string" },
        "nombre":       { "type": "string" },
        "especialidad": { "type": "string" },
        "eta_min":      { "type": "number" },
        "razon":        { "type": "string", "description": "Por qué se eligió (trazabilidad)" }
      }
    },
    "repuestos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repuesto_id": { "type": "string" },
          "almacen":     { "type": "string" },
          "cantidad":    { "type": "integer" },
          "disponible":  { "type": "boolean" }
        }
      }
    },
    "linea_tiempo": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ts", "evento"],
        "properties": {
          "ts":      { "type": "string", "format": "date-time" },
          "evento":  { "type": "string" },
          "detalle": { "type": "string" }
        }
      }
    },
    "cierre": {
      "type": ["object", "null"],
      "properties": {
        "cerrado_ts":             { "type": "string", "format": "date-time" },
        "minutos_detenida":       { "type": "number" },
        "intervencion":           { "type": "string" },
        "componentes_reemplazados": { "type": "array", "items": { "type": "string" } },
        "falla_confirmada":       { "type": "boolean", "description": "Lo decide el técnico, no la plataforma" }
      }
    },
    "task_token": { "type": ["string", "null"], "description": "Token de Step Functions para cerrar desde la web. No se replica a Firestore" }
  }
}
